{
	"name": "@blackswampai/n8n-nodes-studiocms",
	"version": "0.1.2",
	"packageManager": "npm@11.19.0",
	"description": "n8n community node for the StudioCMS REST API",
	"license": "MIT",
	"homepage": "https://blackswampai.com/n8n-nodes/studiocms/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"studiocms"
	],
	"author": {
		"name": "Christopher J. Nelson",
		"email": "christopherjnelson@proton.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/BlackSwampAI/n8n-nodes-studiocms.git"
	},
	"bugs": {
		"url": "https://github.com/BlackSwampAI/n8n-nodes-studiocms/issues"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"release:check": "node scripts/release-check.mjs",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"scan:source": "node scripts/scan-source.mjs",
		"scan:published": "node scripts/scan-published.mjs",
		"package:check": "node scripts/package-check.mjs",
		"smoke:load": "node scripts/node-load-smoke.mjs",
		"smoke:install": "node scripts/packed-install-smoke.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/StudioCmsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/StudioCms/StudioCms.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.46.4",
		"@n8n/scan-community-package": "0.34.0",
		"@types/node": "^22.0.0",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"allowScripts": {
		"eslint-plugin-n8n-nodes-base": false
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
